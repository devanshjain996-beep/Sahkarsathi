# Supabase Client Configuration
# Replace these values with your actual Supabase Project Settings > API credentials.
# NOTE: Only use the Project URL and Anon/Publishable Key here. NEVER use the Service Role Key.

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-publishable-key-here
